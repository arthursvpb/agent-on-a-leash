CLASSIFIER=offline
MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# Other providers use their own integration package and credentials.
# OPENAI_ADMIN_KEY is also recognized by the OpenAI SDK.
# LLM-as-judge for reply quality (make eval-judge); defaults to MODEL.
JUDGE=off
JUDGE_MODEL=openai:gpt-4.1-mini
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-on-a-leash
LEASH_TODAY=2026-03-15
